# EMG website server — copy to .env and fill in. Never commit .env.

PORT=8787
# Where submissions (submissions.jsonl) and uploads are kept. Back this folder up.
DATA_DIR=data
# Serve the built site from dist/ as well as the API (true for a single Node app on Hostinger)
SERVE_SITE=true

# Email notifications (e.g. Hostinger mail: smtp.hostinger.com, port 465, SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who receives new submissions (comma-separated)
NOTIFY_TO=
# Send the visitor a short "we received your message" email
ACK_EMAIL=false

# Admin access to submissions/CSV/files: a long random string (24+ characters). Empty = admin off.
ADMIN_TOKEN=

# Only if the site is hosted on a different domain than this server (comma-separated origins)
ALLOWED_ORIGINS=
# Abuse protection: max submissions per IP per window
RATE_MAX=6
RATE_WINDOW_MIN=10
# Number of proxies in front of the app (Hostinger: 1)
TRUST_PROXY=1
